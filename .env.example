# ---- 必須 ----

# このサーバーの URL。**パスを付けない**
OAUTH_ISSUER=https://kintone-remote-mcp-xxxxxxxx.asia-northeast1.run.app

# Host ヘッダーの許可リスト（DNS rebinding 対策）。OAUTH_ISSUER のホスト名
ALLOWED_HOSTS=kintone-remote-mcp-xxxxxxxx.asia-northeast1.run.app

# 繋ぎ先の kintone。**1デプロイにつき1ドメイン**
# cybozu.com の OAuth はエンドポイントがドメイン固有なので、
# 別のドメインを使うならもう1つデプロイする
KINTONE_BASE_URL=https://example.cybozu.com

# cybozu.com 共通管理 → OAuth で登録したクライアント
# ⚠ シークレットの末尾に改行を入れない（Basic 認証が壊れて 401 invalid_client になる）
CYBOZU_OAUTH_CLIENT_ID=
CYBOZU_OAUTH_CLIENT_SECRET=

# Cookie 署名鍵。**全インスタンスで共有する**
#   openssl rand -base64 32 | tr -d '\n'
COOKIE_KEYS=

# id_token の署名鍵（JWKS）
# ⚠ 未設定だと oidc-provider に**同梱された公開済みの固定鍵**で署名する
OIDC_JWKS=

# ---- トークン暗号鍵（どちらか一方）----

# (A) 生の鍵。**本番では使わない**（設定を読める者がそのまま鍵を得る）
TOKEN_ENCRYPTION_KEY=

# (B) Cloud KMS で包んだ鍵。本番はこちら（手順は docs/deployment.md）
# KMS_KEY_NAME=projects/PROJECT/locations/REGION/keyRings/kintone-mcp/cryptoKeys/token-key
# TOKEN_ENCRYPTION_KEY_CIPHERTEXT=

# ---- 任意 ----

# ⚠ 環境変数 FIRESTORE_DATABASE は SDK が読まない。このサーバーが読んで渡している
FIRESTORE_DATABASE=kintone-mcp
FIRESTORE_COLLECTION=oidc

# 信頼する転送ヘッダーの段数。Cloud Run の直 URL なら 1、前段に外部 LB を置くと 2
# ⚠ true にしない。X-Forwarded-For の左端は送信者が自由に書ける
TRUSTED_PROXY_HOPS=1

# cybozu に要求するスコープ。書き込みを使うなら k:app_record:write を足す
# ⚠ cybozu 側では登録・更新・削除がすべて k:app_record:write に含まれる。
#   削除だけを止める仕組みは、こちらの ALLOW_DESTRUCTIVE しかない
CYBOZU_OAUTH_SCOPES=k:app_record:read k:app_settings:read

# 公開するツール（既定は読み取りのみ）
ENABLE_RECORD_READ=true
ENABLE_APP_READ=true
ENABLE_RECORD_WRITE=false
ENABLE_APP_WRITE=false
ALLOW_DESTRUCTIVE=false

# 触れるアプリを絞る。**空は「制限なし」**
ALLOWED_APP_IDS=

# 上限。⚠ インスタンス単位でしか効かない（docs/deployment.md の負荷予算を参照）
RATE_LIMIT_PRE_AUTH_PER_MINUTE=60
RATE_LIMIT_PRE_AUTH_TOTAL_PER_MINUTE=600
RATE_LIMIT_GRANT_PER_MINUTE=120
MAX_CONCURRENT_PER_GRANT=4
MAX_CONCURRENT_TOTAL=8

# 期限。REQUEST_DEADLINE_MS は Cloud Run の --timeout より短く、
# CYBOZU_TIMEOUT_MS と STORAGE_TIMEOUT_MS はそれより短くする
REQUEST_DEADLINE_MS=55000
CYBOZU_TIMEOUT_MS=10000
STORAGE_TIMEOUT_MS=5000

# ---- ローカルで試すときだけ ----
# ALLOW_INSECURE_ISSUER=true
# SECURE_COOKIES=false

# ---- 連携用ユーザー（スペース操作と検索を使う場合だけ）----
# OAuth で実行できない5ツールを、このユーザーとして実行する。
#
# ⚠ **接続した本人ではなく、このユーザーとして実行されます。**
#   本人が見られないものにも手が届きます。
# ⚠ **パスワード認証にはスコープがありません。** そのユーザーができること全部です。
#   権限を絞った専用ユーザーを用意してください。
# ⚠ **2要素認証を有効にしたユーザーでは使えません。**
# ⚠ ALLOWED_APP_IDS と併用すると kintone-search は公開されません。
#
# 設定したうえで ENABLE_SPACE_READ / ENABLE_SPACE_WRITE / ENABLE_SEARCH が要ります。
# KINTONE_INTEGRATION_USERNAME=
# KINTONE_INTEGRATION_PASSWORD=
